<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 允许用户自行填写 http:// 形式的第三方 API（对话 / 论坛 / 生图等） -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
